# =============================================================================
# Levee — example environment. Copy to `.env` and fill in. NEVER commit `.env`.
# Everything targets Solana DEVNET.
# =============================================================================

# ---- Cluster / RPC ---------------------------------------------------------
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Optional WebSocket endpoint (defaults derived from RPC_URL if unset)
WS_URL=wss://api.devnet.solana.com

# ---- Program ---------------------------------------------------------------
# Filled in after `anchor deploy`. Must match program/Anchor.toml + declare_id!.
LEVEE_PROGRAM_ID=Lev1iS1111111111111111111111111111111111111

# Circle devnet USDC mint (default). Override only if using a custom test mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---- Admin / deploy keypair ------------------------------------------------
# Path to the keypair that deploys the program and is RegionConfig.authority.
# Generate: solana-keygen new -o ~/.config/solana/levee-admin.json
ADMIN_KEYPAIR_PATH=/absolute/path/to/levee-admin.json

# ---- Oracle (Switchboard On-Demand) ----------------------------------------
# Public key of the deployed On-Demand pull feed (created by oracle/ scripts).
SWITCHBOARD_FEED_PUBKEY=
# Switchboard On-Demand program / queue (devnet defaults are set in oracle code).
SWITCHBOARD_QUEUE=
# Feed freshness guards — MUST match what execute_payout enforces on-chain.
ORACLE_MAX_STALENESS_SECONDS=300
ORACLE_MIN_SAMPLES=1

# ---- Risk model API --------------------------------------------------------
MODEL_API_URL=http://localhost:8000
# The oracle job and the agent both call: ${MODEL_API_URL}/risk?region_id=...

# ---- Agent: Privy embedded wallet ------------------------------------------
# https://dashboard.privy.io — server wallets for the autonomous agent signer.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ID + Solana address of the pre-provisioned Privy server wallet the agent uses.
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
# If none of the PRIVY_* values are set, the agent falls back to a LOCAL keypair
# at ADMIN_KEYPAIR_PATH (devnet bring-up / CI only — not for production).

# ---- Agent: behavior / safety ----------------------------------------------
# Comma-separated region_ids the agent monitors.
AGENT_REGIONS=1
# Main loop interval (seconds).
AGENT_POLL_INTERVAL_SECONDS=60
# Human-in-the-loop: payouts whose TOTAL exceeds this (whole USDC) require
# manual approval before execute_payout is sent.
HITL_APPROVAL_THRESHOLD_USDC=2000
# Set to "true" to plan/preview only and never send payout transactions.
AGENT_DRY_RUN=true
# Set to "true" to auto-approve HITL prompts (demo only). Default: human/deny.
HITL_AUTO_APPROVE=false

# Optional: override the path to the Anchor IDL (default: program/target/idl/levee.json)
# LEVEE_IDL_PATH=/absolute/path/to/levee.json

# ---- Model service ---------------------------------------------------------
MODEL_HOST=0.0.0.0
MODEL_PORT=8000

# ---- Early-warning outputs -------------------------------------------------
# Optional webhook the model POSTs WARNING/CRITICAL alerts to (Slack, ops, etc.)
ALERT_WEBHOOK_URL=

# ---- Monitoring (Sentry) — optional, active only if SENTRY_DSN is set -------
SENTRY_DSN=
SENTRY_ENV=devnet
SENTRY_TRACES_SAMPLE_RATE=0.1
